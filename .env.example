OPENROUTER_API_KEY=
# Recommended free models (top = default)
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
# Any other OpenRouter slug also works, including paid models.
# OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional comma-separated fallbacks if the primary model is unavailable.
# OPENROUTER_FALLBACK_MODELS=nex-agi/nex-n2.5-mini:free,openrouter/free
# Optional writing tone used for every recommendation.
# EMOTE_TONE=warm and light
# Optional sampling temperature (0–1). Lower is more consistent.
# EMOTE_TEMPERATURE=0.2
